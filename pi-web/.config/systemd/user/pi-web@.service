[Unit]
Description=pi RPC session (one instance per socket connection)

[Service]
Type=simple
# The accepted connection IS this process's stdio. That single fact is what lets the
# web frontend be a pure relay with no process supervision of its own.
StandardInput=socket
StandardOutput=socket
StandardError=journal

# The agent's project root. NOT /tmp: it decides session grouping (pi buckets sessions
# under a cwd-derived folder), which AGENTS.md files are found, and whether repo-local
# .pi/ resources load. Fixed per unit — the RPC protocol cannot change cwd.
WorkingDirectory=%h/repos
Environment=TZ=Europe/Madrid
Environment=PI_OFFLINE=1
Environment=PI_TELEMETRY=0

# NOT /usr/bin/pi: the install is user-local (~/.local/bin), and systemd user units do
# not inherit the login-shell PATH that contains it.
#
# No --session-dir on purpose: passing it explicitly flattens the layout, dropping the
# cwd-derived bucket per project (verified). The default ~/.pi/agent/sessions keeps the
# same shape as an interactive `pi`, so `pi -r` and the web UI list the same sessions.
ExecStart=%h/.local/bin/pi --mode rpc

# Per instance. Measured idle is ~130 MB; this is turn-spike headroom, x3 sessions max.
MemoryMax=1000M
TasksMax=256
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
